ext fn malloc(size: u64) -> *u8;
ext fn calloc(n: u64, size: u64) -> *u8;
ext fn realloc(ptr: *u8, size: u64) -> *u8;
ext fn free(ptr: *u8);
ext fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;
ext fn memmove(dst: *u8, src: *u8, n: u64) -> *u8;
ext fn memset(dst: *u8, c: i32, n: u64) -> *u8;
ext fn memcmp(a: *u8, b: *u8, n: u64) -> i32;
